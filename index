<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Pendeteksi & Penghitung Push-Up AI</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            500: '#10b981', // Emerald 500
                            600: '#059669',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #090d16;
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 3px;
        }
        /* Pulse animation for active recording indicator */
        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.8; }
            70% { transform: scale(1.6); opacity: 0; }
            100% { transform: scale(1.6); opacity: 0; }
        }
        .pulse-dot::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background-color: inherit;
            animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-emerald-500 selection:text-white">

    <!-- Header -->
    <header class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-emerald-500/10 border border-emerald-500/30 p-2 rounded-xl text-emerald-400">
                    <i data-lucide="activity" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-bold text-base sm:text-lg tracking-tight text-white leading-tight">
                        Pendeteksi Push-Up <span class="text-emerald-400">AI</span>
                    </h1>
                    <p class="text-[11px] text-slate-400 hidden sm:block">Pelacak Postur & Repetisi Real-Time</p>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                <!-- AI Status Pill -->
                <div id="ai-status-badge" class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-medium">
                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                    <span id="ai-status-text">Memuat Model AI...</span>
                </div>

                <!-- Sound Toggle -->
                <button id="btn-sound" title="Suara Efek" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition active:scale-95">
                    <i data-lucide="volume-2" id="icon-sound-on" class="w-5 h-5 text-emerald-400"></i>
                    <i data-lucide="volume-x" id="icon-sound-off" class="w-5 h-5 text-slate-400 hidden"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
        
        <!-- Alert / Message Toast Banner -->
        <div id="toast-banner" class="hidden mb-4 p-3.5 rounded-2xl border flex items-center justify-between gap-3 transition-all duration-300">
            <div class="flex items-center gap-3">
                <i id="toast-icon" data-lucide="info" class="w-5 h-5 shrink-0"></i>
                <p id="toast-message" class="text-sm font-medium"></p>
            </div>
            <button onclick="hideToast()" class="text-current opacity-70 hover:opacity-100 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- Left Column: Camera Viewport & Controls (7 cols on desktop) -->
            <div class="lg:col-span-7 flex flex-col gap-4">
                
                <!-- Video & Canvas Wrapper -->
                <div class="relative w-full aspect-[4/3] sm:aspect-video bg-slate-950 rounded-3xl overflow-hidden border border-slate-800 shadow-2xl flex items-center justify-center group">
                    
                    <!-- Hidden raw video element -->
                    <video id="webcam" class="hidden" playsinline muted></video>
                    
                    <!-- Output Canvas for Video + Pose Skeleton -->
                    <canvas id="output_canvas" class="w-full h-full object-contain"></canvas>

                    <!-- Placeholder Overlay when Camera is Off -->
                    <div id="camera-placeholder" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-900/90 backdrop-blur-sm p-6 text-center z-10">
                        <div class="w-16 h-16 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center mb-4 text-emerald-400 shadow-lg">
                            <i data-lucide="camera" class="w-8 h-8"></i>
                        </div>
                        <h2 class="text-lg sm:text-xl font-bold text-white mb-2">Kamera Belum Aktif</h2>
                        <p class="text-xs sm:text-sm text-slate-400 max-w-md mb-6 leading-relaxed">
                            Mendukung posisi kamera dari <strong>Samping</strong> maupun langsung dari <strong>Depan</strong>. Pilih mode sudut pandang kamera di bawah atau gunakan deteksi otomatis.
                        </p>
                        <button id="btn-start-overlay" disabled class="px-6 py-3 rounded-2xl bg-emerald-500 hover:bg-emerald-600 disabled:bg-slate-700 disabled:text-slate-400 text-slate-950 font-bold text-sm flex items-center gap-2 shadow-lg shadow-emerald-500/20 transition transform active:scale-95">
                            <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                            <span>Mulai Kamera Sekarang</span>
                        </button>
                    </div>

                    <!-- Top Overlay HUD inside Canvas -->
                    <div id="canvas-hud-top" class="hidden absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none z-20">
                        <!-- Live Indicator -->
                        <div id="live-status-pill" class="flex items-center gap-2 bg-slate-950/75 backdrop-blur-md px-3 py-1.5 rounded-full border border-slate-700/70 transition-colors">
                            <span id="live-dot-container" class="relative flex h-2.5 w-2.5">
                                <span id="live-dot-ping" class="pulse-dot absolute inline-flex h-full w-full rounded-full bg-rose-500"></span>
                                <span id="live-dot-core" class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                            </span>
                            <span id="live-status-text" class="text-xs font-semibold tracking-wider text-slate-200 uppercase">AI Aktif</span>
                        </div>

                        <!-- Detected Angle/Side Badge -->
                        <div id="side-badge" class="bg-slate-950/75 backdrop-blur-md px-3 py-1.5 rounded-full border border-slate-700/70 text-xs font-medium text-slate-300">
                            Sudut: <span id="detected-side" class="text-emerald-400 font-bold">-</span>
                        </div>
                    </div>

                    <!-- Center Pause Overlay inside Canvas -->
                    <div id="pause-overlay" class="hidden absolute inset-0 z-20 bg-slate-950/55 backdrop-blur-[2px] flex flex-col items-center justify-center p-4 text-center pointer-events-none transition-opacity duration-200">
                        <div class="bg-slate-900/95 border-2 border-amber-500/80 px-6 py-4 rounded-3xl shadow-2xl flex flex-col items-center gap-2 max-w-xs">
                            <div class="w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center mb-0.5">
                                <i data-lucide="pause-circle" class="w-7 h-7"></i>
                            </div>
                            <span class="text-base sm:text-lg font-black tracking-wider text-amber-400 uppercase">LATIHAN DIJEDA</span>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                Hitungan repetisi &amp; waktu berhenti sementara. Tekan <span class="font-bold text-white">Lanjutkan</span> atau <kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-[10px] font-mono text-amber-300">Spasi</kbd>.
                            </p>
                        </div>
                    </div>

                    <!-- Bottom Form Feedback Banner inside Canvas -->
                    <div id="form-feedback-overlay" class="hidden absolute bottom-3 left-3 right-3 z-20 pointer-events-none">
                        <div id="form-banner-box" class="bg-slate-900/90 backdrop-blur-md border border-slate-700 px-4 py-3 rounded-2xl flex items-center justify-between shadow-lg transition-colors duration-200">
                            <div class="flex items-center gap-3">
                                <div id="form-icon-bg" class="p-2 rounded-xl bg-emerald-500/20 text-emerald-400">
                                    <i id="form-icon" data-lucide="check-circle-2" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <p class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Evaluasi Postur</p>
                                    <p id="form-feedback-text" class="text-sm sm:text-base font-bold text-white">Posisi Siap</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p id="secondary-metric-label" class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Kelurusan Badan</p>
                                <p id="body-angle-text" class="text-sm font-mono font-bold text-emerald-400">--°</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Camera View Mode Selector (Auto / Side / Front) -->
                <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div class="flex items-center gap-2 px-2 text-xs font-semibold text-slate-300">
                        <i data-lucide="scan-face" class="w-4 h-4 text-emerald-400"></i>
                        <span>Posisi Sensor Kamera:</span>
                    </div>
                    <div class="grid grid-cols-3 gap-1.5 bg-slate-950 p-1 rounded-xl border border-slate-800/80">
                        <button type="button" data-view-mode="auto" class="view-mode-btn px-3 py-1.5 rounded-lg text-xs font-bold transition bg-emerald-500 text-slate-950 shadow">
                            Otomatis
                        </button>
                        <button type="button" data-view-mode="side" class="view-mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-400 hover:text-white">
                            Samping
                        </button>
                        <button type="button" data-view-mode="front" class="view-mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-400 hover:text-white">
                            Depan
                        </button>
                    </div>
                </div>

                <!-- Control Bar -->
                <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5 sm:gap-3">
                    <button id="btn-toggle-cam" disabled class="col-span-2 sm:col-span-2 py-3.5 px-4 rounded-2xl bg-emerald-500 hover:bg-emerald-600 disabled:bg-slate-800 disabled:text-slate-500 text-slate-950 font-bold text-sm flex items-center justify-center gap-2 transition active:scale-95 shadow-lg shadow-emerald-500/10">
                        <i data-lucide="video" id="cam-btn-icon" class="w-5 h-5"></i>
                        <span id="cam-btn-text">Mulai Kamera</span>
                    </button>

                    <button id="btn-pause" disabled class="col-span-2 sm:col-span-1 py-3.5 px-3 rounded-2xl bg-amber-500/15 hover:bg-amber-500/25 disabled:bg-slate-800/60 disabled:border-slate-800 disabled:text-slate-600 text-amber-400 border border-amber-500/40 font-bold text-sm flex items-center justify-center gap-2 transition active:scale-95">
                        <i data-lucide="pause" id="pause-btn-icon" class="w-4 h-4"></i>
                        <span id="pause-btn-text">Jeda</span>
                    </button>

                    <button id="btn-switch-cam" class="py-3.5 px-3 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold text-sm flex items-center justify-center gap-2 transition active:scale-95">
                        <i data-lucide="refresh-cw" class="w-4 h-4 text-sky-400"></i>
                        <span>Kamera</span>
                    </button>

                    <button id="btn-reset" class="py-3.5 px-3 rounded-2xl bg-slate-800 hover:bg-rose-950/60 hover:border-rose-800 hover:text-rose-300 text-slate-200 border border-slate-700 font-semibold text-sm flex items-center justify-center gap-2 transition active:scale-95">
                        <i data-lucide="rotate-ccw" class="w-4 h-4 text-rose-400"></i>
                        <span>Reset</span>
                    </button>
                </div>

                <!-- Quick Setup Guide Card -->
                <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 flex items-start gap-3.5">
                    <div class="p-2 rounded-xl bg-sky-500/10 text-sky-400 shrink-0 mt-0.5">
                        <i data-lucide="lightbulb" class="w-5 h-5"></i>
                    </div>
                    <div class="text-xs text-slate-300 space-y-1 leading-relaxed">
                        <p class="font-semibold text-white">Panduan Sensor Samping &amp; Depan:</p>
                        <ul class="list-disc list-inside text-slate-400 space-y-0.5">
                            <li><strong>Mode Samping:</strong> Mengukur sudut siku (<strong>&lt; 90°</strong> turun, <strong>&gt; 150°</strong> naik) dan kelurusan badan (bahu–pinggul–kaki).</li>
                            <li><strong>Mode Depan:</strong> Letakkan ponsel/laptop di depan wajah Anda. Sensor melacak <strong>sudut kedua siku (kiri &amp; kanan)</strong> serta penurunan jarak bahu terhadap pergelangan tangan.</li>
                            <li><strong>Mode Otomatis:</strong> Mendeteksi otomatis apakah tubuh Anda menghadap ke depan atau menyamping terhadap kamera.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Column: Fitness Stats Dashboard (5 cols on desktop) -->
            <div class="lg:col-span-5 flex flex-col gap-4">
                
                <!-- Main Rep Counter & Stage Card -->
                <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-slate-800/90 border border-slate-800 rounded-3xl p-6 shadow-xl relative overflow-hidden">
                    <!-- Subtle decorative glow -->
                    <div class="absolute -top-16 -right-16 w-40 h-40 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Total Push-Up</span>
                        <!-- Stage Badge -->
                        <span id="stage-badge" class="px-3.5 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-slate-800 text-slate-300 border border-slate-700 transition-colors">
                            SIAP
                        </span>
                    </div>

                    <div class="flex items-baseline gap-3 my-2">
                        <span id="rep-count" class="text-7xl sm:text-8xl font-black tracking-tighter text-white tabular-nums">0</span>
                        <span class="text-lg font-semibold text-slate-400">/ <span id="target-display">20</span> rep</span>
                    </div>

                    <!-- Target Progress Bar -->
                    <div class="mt-4 space-y-2">
                        <div class="flex justify-between text-xs font-medium">
                            <span class="text-slate-400">Progres Target Latihan</span>
                            <span id="progress-percent" class="text-emerald-400 font-bold">0%</span>
                        </div>
                        <div class="w-full h-3 bg-slate-950 rounded-full overflow-hidden p-0.5 border border-slate-800">
                            <div id="progress-bar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full transition-all duration-300" style="width: 0%"></div>
                        </div>
                    </div>

                    <!-- Target Selector -->
                    <div class="mt-5 pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
                        <label for="target-input" class="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                            <i data-lucide="target" class="w-4 h-4 text-emerald-400"></i>
                            <span>Target Repetisi:</span>
                        </label>
                        <div class="flex items-center gap-1.5">
                            <button onclick="adjustTarget(-5)" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm flex items-center justify-center transition">-5</button>
                            <input type="number" id="target-input" value="20" min="1" max="500" class="w-16 h-8 bg-slate-950 border border-slate-700 rounded-lg text-center text-sm font-bold text-white focus:outline-none focus:border-emerald-500">
                            <button onclick="adjustTarget(5)" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm flex items-center justify-center transition">+5</button>
                        </div>
                    </div>
                </div>

                <!-- Elbow Angle Gauge Card -->
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-lg">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <div class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400">
                                <i data-lucide="gauge" class="w-4 h-4"></i>
                            </div>
                            <span id="gauge-title" class="text-xs font-bold uppercase tracking-wider text-slate-300">Sudut Tekukan Siku</span>
                        </div>
                        <span id="elbow-angle-val" class="text-2xl font-black font-mono text-amber-400">--°</span>
                    </div>

                    <!-- Visual Angle Bar -->
                    <div class="relative w-full h-4 bg-slate-950 rounded-full overflow-hidden border border-slate-800 mb-2">
                        <!-- Threshold markers -->
                        <div id="marker-down" class="absolute top-0 bottom-0 left-[50%] w-0.5 bg-emerald-500/50 z-10" title="Batas Bawah (90°)"></div>
                        <div id="marker-up" class="absolute top-0 bottom-0 left-[83%] w-0.5 bg-sky-500/50 z-10" title="Batas Atas (150°)"></div>
                        <!-- Dynamic Bar -->
                        <div id="angle-bar" class="h-full bg-gradient-to-r from-rose-500 via-amber-400 to-emerald-500 transition-all duration-100 rounded-full" style="width: 0%"></div>
                    </div>
                    <div id="gauge-labels" class="flex justify-between text-[10px] font-semibold text-slate-500">
                        <span>0° (Penuh)</span>
                        <span class="text-emerald-400">90° (Turun)</span>
                        <span class="text-sky-400">150°+ (Naik)</span>
                    </div>
                </div>

                <!-- Workout Metrics Grid (Timer & Calories) -->
                <div class="grid grid-cols-2 gap-4">
                    <!-- Workout Timer -->
                    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-lg flex flex-col justify-between">
                        <div class="flex items-center gap-2 text-slate-400 mb-2">
                            <i data-lucide="timer" class="w-4 h-4 text-sky-400"></i>
                            <span class="text-xs font-bold uppercase tracking-wider">Durasi Latihan</span>
                        </div>
                        <div>
                            <p id="timer-display" class="text-2xl sm:text-3xl font-black font-mono text-white tracking-tight">00:00</p>
                            <p class="text-[11px] text-slate-500 mt-0.5">Menit : Detik</p>
                        </div>
                    </div>

                    <!-- Estimated Calories -->
                    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-lg flex flex-col justify-between">
                        <div class="flex items-center gap-2 text-slate-400 mb-2">
                            <i data-lucide="flame" class="w-4 h-4 text-orange-400"></i>
                            <span class="text-xs font-bold uppercase tracking-wider">Estimasi Kalori</span>
                        </div>
                        <div>
                            <p class="text-2xl sm:text-3xl font-black font-mono text-white tracking-tight">
                                <span id="calories-display">0.0</span> <span class="text-sm font-bold text-orange-400">kkal</span>
                            </p>
                            <p class="text-[11px] text-slate-500 mt-0.5">~0.45 kkal / rep</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950 py-4 mt-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
            Ditenagai oleh <span class="text-slate-300 font-semibold">MediaPipe Pose Landmarker</span> &bull; Pemrosesan AI 100% Lokal di Perangkat Anda (Privasi Terjaga).
        </div>
    </footer>

    <!-- MediaPipe Tasks Vision & Application Logic -->
    <script type="module">
        import {
            PoseLandmarker,
            FilesetResolver
        } from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs";

        // Initialize Lucide Icons
        lucide.createIcons();

        // ==========================================
        // 1. STATE & CONFIGURATION
        // ==========================================
        let poseLandmarker = null;
        let isModelLoaded = false;
        let isCameraRunning = false;
        let isPaused = false;
        let facingMode = "user"; // 'user' (depan) or 'environment' (belakang)
        let cameraViewMode = "auto"; // 'auto' | 'side' | 'front'
        let animationFrameId = null;
        let lastVideoTime = -1;

        // Workout & Rep State
        let repCount = 0;
        let targetReps = 20;
        let pushupStage = "SIAP"; // 'SIAP', 'NAIK', 'TURUN'
        let targetReachedNotified = false;
        let soundEnabled = true;

        // Angle & Front-depth smoothing buffer
        const angleHistory = [];
        const depthHistory = [];
        const SMOOTHING_WINDOW = 4;

        // Timer State
        let timerInterval = null;
        let elapsedSeconds = 0;

        // ==========================================
        // 2. DOM ELEMENTS
        // ==========================================
        const video = document.getElementById("webcam");
        const canvas = document.getElementById("output_canvas");
        const ctx = canvas.getContext("2d");

        const aiStatusBadge = document.getElementById("ai-status-badge");
        const aiStatusText = document.getElementById("ai-status-text");

        const cameraPlaceholder = document.getElementById("camera-placeholder");
        const canvasHudTop = document.getElementById("canvas-hud-top");
        const formFeedbackOverlay = document.getElementById("form-feedback-overlay");

        const btnStartOverlay = document.getElementById("btn-start-overlay");
        const btnToggleCam = document.getElementById("btn-toggle-cam");
        const camBtnText = document.getElementById("cam-btn-text");
        const btnPause = document.getElementById("btn-pause");
        const pauseBtnText = document.getElementById("pause-btn-text");
        const btnSwitchCam = document.getElementById("btn-switch-cam");
        const btnReset = document.getElementById("btn-reset");
        const btnSound = document.getElementById("btn-sound");

        const pauseOverlay = document.getElementById("pause-overlay");
        const liveStatusText = document.getElementById("live-status-text");
        const liveDotPing = document.getElementById("live-dot-ping");
        const liveDotCore = document.getElementById("live-dot-core");

        const repCountEl = document.getElementById("rep-count");
        const stageBadgeEl = document.getElementById("stage-badge");
        const targetDisplayEl = document.getElementById("target-display");
        const targetInputEl = document.getElementById("target-input");
        const progressPercentEl = document.getElementById("progress-percent");
        const progressBarEl = document.getElementById("progress-bar");

        const elbowAngleValEl = document.getElementById("elbow-angle-val");
        const angleBarEl = document.getElementById("angle-bar");
        const detectedSideEl = document.getElementById("detected-side");
        const gaugeTitleEl = document.getElementById("gauge-title");
        const gaugeLabelsEl = document.getElementById("gauge-labels");
        const markerDownEl = document.getElementById("marker-down");
        const markerUpEl = document.getElementById("marker-up");
        const secondaryMetricLabelEl = document.getElementById("secondary-metric-label");

