                aiStatusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-400"></span><span>Gagal Memuat AI</span>`;
                showToast("Gagal memuat model deteksi AI. Periksa koneksi internet Anda lalu muat ulang halaman.", "error");
            }
        }

        // ==========================================
        // 6. GEOMETRY & ANGLE CALCULATIONS
        // ==========================================
        function calculateAngle(a, b, c) {
            const radians = Math.atan2(c.y - b.y, c.x - b.x) - Math.atan2(a.y - b.y, a.x - b.x);
            let angle = Math.abs((radians * 180.0) / Math.PI);
            if (angle > 180.0) {
                angle = 360.0 - angle;
            }
            return angle;
        }

        function getSmoothedAngle(rawAngle) {
            angleHistory.push(rawAngle);
            if (angleHistory.length > SMOOTHING_WINDOW) {
                angleHistory.shift();
            }
            const sum = angleHistory.reduce((acc, val) => acc + val, 0);
            return sum / angleHistory.length;
        }

        function getSmoothedDepth(rawDepth) {
            depthHistory.push(rawDepth);
            if (depthHistory.length > SMOOTHING_WINDOW) {
                depthHistory.shift();
            }
            const sum = depthHistory.reduce((acc, val) => acc + val, 0);
            return sum / depthHistory.length;
        }

        function calculateDistance2D(p1, p2) {
            return Math.hypot(p1.x - p2.x, p1.y - p2.y);
        }

        // ==========================================
        // 7. CAMERA CONTROL & WORKOUT TIMER
        // ==========================================
        function startWorkoutTimer() {
            if (timerInterval) return;
            timerInterval = setInterval(() => {
                elapsedSeconds++;
                const mins = String(Math.floor(elapsedSeconds / 60)).padStart(2, "0");
                const secs = String(elapsedSeconds % 60).padStart(2, "0");
                timerDisplayEl.textContent = `${mins}:${secs}`;
            }, 1000);
        }

        function stopWorkoutTimer() {
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
        }

        async function startCamera() {
            if (!isModelLoaded) return;

            if (video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
            }

            try {
                const constraints = {
                    video: {
                        facingMode: facingMode,
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    },
                    audio: false
                };

                const stream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = stream;
                await video.play();

                // Match canvas resolution to actual video stream resolution
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;

                isCameraRunning = true;
                setPausedState(false, true);
                updateCameraUI(true);
                startWorkoutTimer();
                hideToast();

                // Start real-time detection loop
                lastVideoTime = -1;
                predictWebcam();

            } catch (err) {
                console.error("Camera error:", err);
                showToast("Tidak dapat mengakses kamera. Pastikan izin kamera telah diberikan pada browser Anda.", "error");
            }
        }

        function stopCamera() {
            isCameraRunning = false;
            setPausedState(false, true);
            if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
            }
            if (video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
                video.srcObject = null;
            }
            stopWorkoutTimer();
            updateCameraUI(false);
        }

        function setPausedState(paused, silent = false) {
            isPaused = paused;

            if (!isCameraRunning) {
                btnPause.disabled = true;
                pauseOverlay.classList.add("hidden");
                pauseBtnText.textContent = "Jeda";
                btnPause.innerHTML = `<i data-lucide="pause" class="w-4 h-4"></i><span>Jeda</span>`;
                btnPause.className = "col-span-2 sm:col-span-1 py-3.5 px-3 rounded-2xl bg-amber-500/15 hover:bg-amber-500/25 disabled:bg-slate-800/60 disabled:border-slate-800 disabled:text-slate-600 text-amber-400 border border-amber-500/40 font-bold text-sm flex items-center justify-center gap-2 transition active:scale-95";
                lucide.createIcons();
                return;
            }

            btnPause.disabled = false;

            if (isPaused) {
                // Pause workout timer & display overlay
                stopWorkoutTimer();
                pauseOverlay.classList.remove("hidden");
                formFeedbackOverlay.classList.add("hidden");

                // Update HUD pill to Paused
                liveStatusText.textContent = "DIJEDA";
                liveDotPing.classList.add("hidden");
                liveDotCore.className = "relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-400";

                // Update Stage Badge
                updateStageBadge("DIJEDA", "bg-amber-500/20 text-amber-400 border-amber-500/50");

                // Update Pause Button to Resume
                btnPause.className = "col-span-2 sm:col-span-1 py-3.5 px-3 rounded-2xl bg-sky-500 hover:bg-sky-600 text-slate-950 border border-sky-400 font-bold text-sm flex items-center justify-center gap-2 transition active:scale-95 shadow-lg shadow-sky-500/20";
                btnPause.innerHTML = `<i data-lucide="play" class="w-4 h-4 fill-current"></i><span>Lanjutkan</span>`;
            } else {
                // Resume workout timer & hide pause overlay
                startWorkoutTimer();
                pauseOverlay.classList.add("hidden");
                formFeedbackOverlay.classList.remove("hidden");

                // Clear smoothing history so post-pause movement starts fresh
                angleHistory.length = 0;
                depthHistory.length = 0;

                // Update HUD pill back to Active
                liveStatusText.textContent = "AI Aktif";
                liveDotPing.classList.remove("hidden");
                liveDotCore.className = "relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500";

                // Restore Stage Badge
                if (pushupStage === "TURUN") {
                    updateStageBadge("TURUN", "bg-amber-500/20 text-amber-400 border-amber-500/40");
                } else if (pushupStage === "NAIK") {
                    updateStageBadge("NAIK", "bg-sky-500/20 text-sky-400 border-sky-500/40");
                } else {
                    updateStageBadge("SIAP", "bg-slate-800 text-slate-300 border-slate-700");
                }

                // Update Button back to Pause
                btnPause.className = "col-span-2 sm:col-span-1 py-3.5 px-3 rounded-2xl bg-amber-500/15 hover:bg-amber-500/25 text-amber-400 border border-amber-500/40 font-bold text-sm flex items-center justify-center gap-2 transition active:scale-95";
                btnPause.innerHTML = `<i data-lucide="pause" class="w-4 h-4"></i><span>Jeda</span>`;
            }

            lucide.createIcons();
            if (!silent) {
                playPauseCue(isPaused);
            }
        }

