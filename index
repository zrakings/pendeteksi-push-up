        // ==========================================
        // 8. POSE DETECTION & PUSH-UP LOGIC LOOP
        // ==========================================
        function predictWebcam() {
            if (!isCameraRunning) return;

            const startTimeMs = performance.now();
            if (lastVideoTime !== video.currentTime) {
                lastVideoTime = video.currentTime;
                if (isPaused) {
                    drawPausedVideoFrame();
                } else {
                    const results = poseLandmarker.detectForVideo(video, startTimeMs);
                    processAndDrawFrame(results);
                }
            }

            animationFrameId = requestAnimationFrame(predictWebcam);
        }

        function drawPausedVideoFrame() {
            const w = canvas.width;
            const h = canvas.height;

            ctx.save();
            ctx.clearRect(0, 0, w, h);

            if (facingMode === "user") {
                ctx.translate(w, 0);
                ctx.scale(-1, 1);
            }

            // Keep live camera feed visible while paused so user can adjust position
            ctx.drawImage(video, 0, 0, w, h);
            ctx.restore();
        }

        function processAndDrawFrame(results) {
            const w = canvas.width;
            const h = canvas.height;

            ctx.save();
            ctx.clearRect(0, 0, w, h);

            // Mirror horizontally if using front-facing camera
            if (facingMode === "user") {
                ctx.translate(w, 0);
                ctx.scale(-1, 1);
            }

            ctx.drawImage(video, 0, 0, w, h);

            if (results.landmarks && results.landmarks.length > 0) {
                const landmarks = results.landmarks[0];

                const leftShoulder = landmarks[11];
                const rightShoulder = landmarks[12];
                const leftElbow = landmarks[13];
                const rightElbow = landmarks[14];
                const leftWrist = landmarks[15];
                const rightWrist = landmarks[16];
                const leftHip = landmarks[23];
                const rightHip = landmarks[24];
                const leftAnkle = landmarks[27];
                const rightAnkle = landmarks[28];

                // Determine active orientation ('front' vs 'side')
                let activeOrientation = cameraViewMode;
                if (cameraViewMode === "auto") {
                    const bothArmsVisible =
                        (leftShoulder.visibility || 0) > 0.5 &&
                        (rightShoulder.visibility || 0) > 0.5 &&
                        (leftElbow.visibility || 0) > 0.45 &&
                        (rightElbow.visibility || 0) > 0.45;
                    const shoulderSpreadX = Math.abs(leftShoulder.x - rightShoulder.x);
                    const torsoHeightY = Math.abs(
                        ((leftShoulder.y + rightShoulder.y) / 2) - ((leftHip.y + rightHip.y) / 2)
                    );
                    // In front-facing pushups, shoulders span horizontally significantly relative to torso height
                    if (bothArmsVisible && shoulderSpreadX > Math.max(0.14, torsoHeightY * 0.75)) {
                        activeOrientation = "front";
                    } else {
                        activeOrientation = "side";
                    }
                }

                if (activeOrientation === "front") {
                    processFrontView(
                        landmarks,
                        leftShoulder, rightShoulder,
                        leftElbow, rightElbow,
                        leftWrist, rightWrist,
                        leftHip, rightHip,
                        w, h
                    );
                } else {
                    processSideView(
                        landmarks,
                        leftShoulder, rightShoulder,
                        leftElbow, rightElbow,
                        leftWrist, rightWrist,
                        leftHip, rightHip,
                        leftAnkle, rightAnkle,
                        w, h
                    );
                }
            } else {
                detectedSideEl.textContent = "-";
                elbowAngleValEl.textContent = "--°";
                bodyAngleText.textContent = "--°";
                updateFormFeedback("Tubuh Tidak Terdeteksi — Mundur Sedikit", false);
            }

            ctx.restore();
        }

        // ==========================================
        // 8A. SIDE-VIEW SENSOR PROCESSING
        // ==========================================
        function processSideView(
            landmarks,
            leftShoulder, rightShoulder,
            leftElbow, rightElbow,
            leftWrist, rightWrist,
            leftHip, rightHip,
            leftAnkle, rightAnkle,
            w, h
        ) {
            updateGaugeModeUI("side");

            const leftVis = (leftShoulder.visibility || 0) + (leftElbow.visibility || 0) + (leftWrist.visibility || 0);
            const rightVis = (rightShoulder.visibility || 0) + (rightElbow.visibility || 0) + (rightWrist.visibility || 0);

            const useLeft = leftVis >= rightVis;
            detectedSideEl.textContent = `Samping (${useLeft ? "Kiri" : "Kanan"})`;

            const shoulder = useLeft ? leftShoulder : rightShoulder;
            const elbow = useLeft ? leftElbow : rightElbow;
            const wrist = useLeft ? leftWrist : rightWrist;
            const hip = useLeft ? leftHip : rightHip;
            const ankle = useLeft ? leftAnkle : rightAnkle;

            if ((shoulder.visibility || 0) > 0.45 && (elbow.visibility || 0) > 0.45 && (wrist.visibility || 0) > 0.45) {
                const rawElbowAngle = calculateAngle(shoulder, elbow, wrist);
                const elbowAngle = Math.round(getSmoothedAngle(rawElbowAngle));

                elbowAngleValEl.textContent = `${elbowAngle}°`;
                const barPct = Math.min(100, Math.max(0, (elbowAngle / 180) * 100));
                angleBarEl.style.width = `${barPct}%`;

                // Push-Up State Machine (Side View)
                if (elbowAngle > 150) {
                    if (pushupStage === "TURUN") {
                        registerValidRep();
                    }
                    pushupStage = "NAIK";
                    updateStageBadge("NAIK", "bg-sky-500/20 text-sky-400 border-sky-500/40");
                } else if (elbowAngle < 90 && (pushupStage === "NAIK" || pushupStage === "SIAP")) {
                    pushupStage = "TURUN";
                    updateStageBadge("TURUN", "bg-amber-500/20 text-amber-400 border-amber-500/40");
                }

                // Body Alignment Check (Shoulder - Hip - Ankle)
                let isGoodForm = true;
                if ((hip.visibility || 0) > 0.4 && (ankle.visibility || 0) > 0.4) {
                    const bodyAngle = Math.round(calculateAngle(shoulder, hip, ankle));
                    bodyAngleText.textContent = `${bodyAngle}°`;

                    if (bodyAngle < 150) {
                        isGoodForm = false;
                        if (hip.y < shoulder.y) {
                            updateFormFeedback("Pinggul Terlalu Tinggi! Luruskan Badan", false);
                        } else {
                            updateFormFeedback("Pinggul Terlalu Turun! Kencangkan Perut", false);
                        }
                    } else {
                        updateFormFeedback(
                            pushupStage === "TURUN" ? "Bagus! Dorong Tubuh ke Atas" : "Postur Samping Lurus & Ideal",
                            true
                        );
                    }
                } else {
                    bodyAngleText.textContent = "--°";
                    updateFormFeedback("Pastikan Kaki & Pinggul Terlihat Kamera", true);
                }

                // Draw Side Skeleton
                const lineColor = isGoodForm ? "#10b981" : "#f43f5e";
                drawBone(shoulder, elbow, lineColor, 6);
                drawBone(elbow, wrist, lineColor, 6);

                if ((hip.visibility || 0) > 0.4) {
                    drawBone(shoulder, hip, lineColor, 5);
                    if ((ankle.visibility || 0) > 0.4) {
                        drawBone(hip, ankle, lineColor, 5);
                        drawJoint(ankle, "#38bdf8", 7);
                    }
                    drawJoint(hip, "#38bdf8", 8);
                }

                drawJoint(shoulder, "#ffffff", 9);
                drawJoint(elbow, pushupStage === "TURUN" ? "#fbbf24" : "#10b981", 11);
                drawJoint(wrist, "#ffffff", 8);

                drawUnmirroredCanvasLabel(elbow.x * w, elbow.y * h - 18, `${elbowAngle}°`);
            } else {
                updateFormFeedback("Posisikan Tubuh Menyamping di Depan Kamera", false);
            }
        }

        // ==========================================
        // 8B. FRONT-VIEW SENSOR PROCESSING
        // ==========================================
        function processFrontView(
            landmarks,
            leftShoulder, rightShoulder,
            leftElbow, rightElbow,
            leftWrist, rightWrist,
            leftHip, rightHip,
            w, h
        ) {
            updateGaugeModeUI("front");
            detectedSideEl.textContent = "Depan (2 Lengan)";

            const armsVisible =
                (leftShoulder.visibility || 0) > 0.45 &&
                (rightShoulder.visibility || 0) > 0.45 &&
                (leftElbow.visibility || 0) > 0.45 &&
                (rightElbow.visibility || 0) > 0.45 &&
                (leftWrist.visibility || 0) > 0.4 &&
                (rightWrist.visibility || 0) > 0.4;

            if (armsVisible) {
                // 1. Bilateral Elbow Angles (Left & Right)
                const leftAngle = calculateAngle(leftShoulder, leftElbow, leftWrist);
                const rightAngle = calculateAngle(rightShoulder, rightElbow, rightWrist);
                const avgElbowAngle = Math.round(getSmoothedAngle((leftAngle + rightAngle) / 2));

                // 2. Shoulder-to-Wrist Vertical Drop Ratio normalized by Shoulder Width
                const shoulderWidth = Math.max(0.05, calculateDistance2D(leftShoulder, rightShoulder));
                const midShoulderY = (leftShoulder.y + rightShoulder.y) / 2;
                const midWristY = (leftWrist.y + rightWrist.y) / 2;
                // When arms are extended (UP), midWristY - midShoulderY is large (~0.75 - 1.1x shoulderWidth).
                // When chest lowers near floor (DOWN), midShoulderY approaches midWristY (< 0.42x shoulderWidth).
                const rawDepthRatio = Math.max(0, (midWristY - midShoulderY) / shoulderWidth);
                const depthRatio = getSmoothedDepth(rawDepthRatio);
                const depthPct = Math.min(100, Math.round(depthRatio * 100));

                // Update Primary Gauge with Bilateral Elbow Angle
                elbowAngleValEl.textContent = `${avgElbowAngle}°`;
                const barPct = Math.min(100, Math.max(0, (avgElbowAngle / 180) * 100));
                angleBarEl.style.width = `${barPct}%`;

                // 3. Symmetry Check (Left vs Right Elbow & Shoulder tilt)
                const elbowDiff = Math.abs(leftAngle - rightAngle);
                const shoulderTilt = Math.abs(leftShoulder.y - rightShoulder.y) / shoulderWidth;
                const isSymmetrical = elbowDiff <= 24 && shoulderTilt <= 0.22;

                // 4. Push-Up State Machine (Front View combines Elbow Angle + Shoulder Drop)
                const isAtTop = avgElbowAngle > 145 && depthRatio > 0.52;
                const isAtBottom = avgElbowAngle < 102 || depthRatio < 0.42;

                if (isAtTop) {
                    if (pushupStage === "TURUN") {
                        registerValidRep();
                    }
                    pushupStage = "NAIK";
                    updateStageBadge("NAIK", "bg-sky-500/20 text-sky-400 border-sky-500/40");
                } else if (isAtBottom && (pushupStage === "NAIK" || pushupStage === "SIAP")) {
                    pushupStage = "TURUN";
                    updateStageBadge("TURUN", "bg-amber-500/20 text-amber-400 border-amber-500/40");
                }

                // 5. Front Form Evaluation (Symmetry & Hip Sag Check)
                const midHipY = (leftHip.y + rightHip.y) / 2;
                const hipsVisible = (leftHip.visibility || 0) > 0.4 && (rightHip.visibility || 0) > 0.4;

                bodyAngleText.textContent = `${depthPct}%`;

                if (!isSymmetrical) {
                    updateFormFeedback("Dorong Seimbang! Lengan Kiri & Kanan Tidak Rata", false);
                } else if (hipsVisible && midHipY > midWristY + 0.04) {
                    updateFormFeedback("Pinggul Terlalu Turun! Kencangkan Core", false);
                } else {
                    updateFormFeedback(
                        pushupStage === "TURUN" ? "Dada Rendah! Dorong Naik Seimbang" : "Postur Depan Simetris & Stabil",
                        true
                    );
                }

                // 6. Draw Bilateral Front Skeleton
                const lineColor = isSymmetrical ? "#10b981" : "#f43f5e";
                // Shoulder bridge
                drawBone(leftShoulder, rightShoulder, "#38bdf8", 5);
                // Left arm
                drawBone(leftShoulder, leftElbow, lineColor, 6);
                drawBone(leftElbow, leftWrist, lineColor, 6);
                // Right arm
                drawBone(rightShoulder, rightElbow, lineColor, 6);
                drawBone(rightElbow, rightWrist, lineColor, 6);

                if (hipsVisible) {
                    drawBone(leftShoulder, leftHip, "rgba(56, 189, 248, 0.55)", 4);
                    drawBone(rightShoulder, rightHip, "rgba(56, 189, 248, 0.55)", 4);
                    drawBone(leftHip, rightHip, "rgba(56, 189, 248, 0.55)", 4);
                    drawJoint(leftHip, "#38bdf8", 6);
                    drawJoint(rightHip, "#38bdf8", 6);
                }

                const elbowColor = pushupStage === "TURUN" ? "#fbbf24" : "#10b981";
                drawJoint(leftShoulder, "#ffffff", 9);
                drawJoint(rightShoulder, "#ffffff", 9);
                drawJoint(leftElbow, elbowColor, 10);
                drawJoint(rightElbow, elbowColor, 10);
                drawJoint(leftWrist, "#ffffff", 8);
                drawJoint(rightWrist, "#ffffff", 8);

                // Draw Left & Right Elbow Angle Labels
                drawUnmirroredCanvasLabel(leftElbow.x * w, leftElbow.y * h - 16, `${Math.round(leftAngle)}°`);
                drawUnmirroredCanvasLabel(rightElbow.x * w, rightElbow.y * h - 16, `${Math.round(rightAngle)}°`);
            } else {
                bodyAngleText.textContent = "--%";
                updateFormFeedback("Hadapkan Bahu & Kedua Lengan Penuh ke Kamera", false);
            }
        }

        function registerValidRep() {
            repCount++;
            updateRepDisplay();
            playRepSuccess();

            if (repCount >= targetReps && !targetReachedNotified) {
                targetReachedNotified = true;
                playTargetCompleted();
                showToast(`Luar biasa! Target ${targetReps} push-up telah tercapai!`, "success");
            }
        }

        function drawUnmirroredCanvasLabel(x, y, text) {
            ctx.save();
            if (facingMode === "user") {
                ctx.translate(x, y);
                ctx.scale(-1, 1);
                drawAngleLabel(0, 0, text);
            } else {
                drawAngleLabel(x, y, text);
            }
            ctx.restore();
        }

        function updateGaugeModeUI(mode) {
            if (mode === "front") {
                gaugeTitleEl.textContent = "Rata-rata Sudut 2 Siku";
                secondaryMetricLabelEl.textContent = "Tinggi Dada";
                markerDownEl.style.left = "56%";
                markerUpEl.style.left = "80%";
                gaugeLabelsEl.innerHTML = `
                    <span>0° (Penuh)</span>
                    <span class="text-emerald-400">100° (Turun)</span>
                    <span class="text-sky-400">145°+ (Naik)</span>
                `;
            } else {
                gaugeTitleEl.textContent = "Sudut Tekukan Siku";
                secondaryMetricLabelEl.textContent = "Kelurusan Badan";
                markerDownEl.style.left = "50%";
                markerUpEl.style.left = "83%";
                gaugeLabelsEl.innerHTML = `
                    <span>0° (Penuh)</span>
                    <span class="text-emerald-400">90° (Turun)</span>
                    <span class="text-sky-400">150°+ (Naik)</span>
                `;
            }
        }

        function drawBone(p1, p2, color, width) {
            ctx.beginPath();
            ctx.moveTo(p1.x * canvas.width, p1.y * canvas.height);
            ctx.lineTo(p2.x * canvas.width, p2.y * canvas.height);
            ctx.strokeStyle = color;
            ctx.lineWidth = width;
            ctx.lineCap = "round";
            ctx.stroke();
        }

        function drawJoint(p, fillColor, radius) {
            const x = p.x * canvas.width;
            const y = p.y * canvas.height;
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, 2 * Math.PI);
            ctx.fillStyle = fillColor;
            ctx.fill();
            ctx.lineWidth = 3;
            ctx.strokeStyle = "#090d16";
            ctx.stroke();
        }

        function drawAngleLabel(x, y, text) {
            ctx.font = "bold 18px Inter, sans-serif";
            const metrics = ctx.measureText(text);
            const padX = 10;
            const boxW = metrics.width + padX * 2;
            const boxH = 28;

            ctx.fillStyle = "rgba(9, 13, 22, 0.85)";
            ctx.beginPath();
            ctx.roundRect(x - boxW / 2, y - boxH + 6, boxW, boxH, 8);
            ctx.fill();

            ctx.fillStyle = "#fbbf24";
            ctx.textAlign = "center";
            ctx.fillText(text, x, y);
        }

        // ==========================================
        // 9. UI UPDATERS & EVENT HANDLERS
        // ==========================================
        function updateRepDisplay() {
            repCountEl.textContent = repCount;

            // Update Calories (~0.45 kcal per pushup)
            const kcal = (repCount * 0.45).toFixed(1);
            caloriesDisplayEl.textContent = kcal;

            // Update Progress Bar
            const pct = Math.min(100, Math.round((repCount / targetReps) * 100));
            progressPercentEl.textContent = `${pct}%`;
            progressBarEl.style.width = `${pct}%`;
        }

        function updateStageBadge(label, classes) {
            stageBadgeEl.textContent = label;
            stageBadgeEl.className = `px-3.5 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider border transition-colors ${classes}`;
        }

        function updateFormFeedback(text, isGood) {
            formFeedbackText.textContent = text;
            if (isGood) {
                formBannerBox.className = "bg-slate-900/90 backdrop-blur-md border border-emerald-500/40 px-4 py-3 rounded-2xl flex items-center justify-between shadow-lg transition-colors duration-200";
                formIconBg.className = "p-2 rounded-xl bg-emerald-500/20 text-emerald-400";
                bodyAngleText.className = "text-sm font-mono font-bold text-emerald-400";
            } else {
                formBannerBox.className = "bg-rose-950/90 backdrop-blur-md border border-rose-500/50 px-4 py-3 rounded-2xl flex items-center justify-between shadow-lg transition-colors duration-200";
                formIconBg.className = "p-2 rounded-xl bg-rose-500/20 text-rose-400";
                bodyAngleText.className = "text-sm font-mono font-bold text-rose-400";
            }
        }

        window.adjustTarget = function (delta) {
            let val = parseInt(targetInputEl.value, 10) || 20;
            val = Math.min(500, Math.max(1, val + delta));
            targetInputEl.value = val;
            targetReps = val;
            targetDisplayEl.textContent = targetReps;
            targetReachedNotified = repCount >= targetReps;
            updateRepDisplay();
        };

        targetInputEl.addEventListener("change", () => {
            let val = parseInt(targetInputEl.value, 10);
            if (isNaN(val) || val < 1) val = 1;
            if (val > 500) val = 500;
            targetInputEl.value = val;
            targetReps = val;
            targetDisplayEl.textContent = targetReps;
            targetReachedNotified = repCount >= targetReps;
            updateRepDisplay();
        });

        // Event Listeners
        btnStartOverlay.addEventListener("click", startCamera);

        viewModeBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                cameraViewMode = btn.dataset.viewMode;
                angleHistory.length = 0;
                depthHistory.length = 0;

                viewModeBtns.forEach((b) => {
                    if (b === btn) {
                        b.className = "view-mode-btn px-3 py-1.5 rounded-lg text-xs font-bold transition bg-emerald-500 text-slate-950 shadow";
                    } else {
                        b.className = "view-mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-400 hover:text-white";
                    }
                });

                const modeNames = {
                    auto: "Otomatis (Depan & Samping)",
                    side: "Tampak Samping",
                    front: "Tampak Depan"
                };
                showToast(`Mode sensor kamera diatur ke: ${modeNames[cameraViewMode]}.`, "info");
            });
        });

        btnToggleCam.addEventListener("click", () => {
            if (isCameraRunning) {
                stopCamera();
            } else {
                startCamera();
            }
        });

        btnPause.addEventListener("click", togglePause);

        // Spacebar keyboard shortcut for quick Pause / Resume when camera is running
        window.addEventListener("keydown", (e) => {
            if (e.code === "Space" && isCameraRunning) {
                // Avoid triggering when typing inside number inputs
                const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : "";
                if (activeTag === "input" || activeTag === "textarea") return;

                e.preventDefault();
                togglePause();
            }
        });

        btnSwitchCam.addEventListener("click", () => {
            facingMode = (facingMode === "user") ? "environment" : "user";
            if (isCameraRunning) {
                startCamera();
            } else {
                showToast(`Kamera diatur ke kamera ${facingMode === "user" ? "Depan" : "Belakang"}. Tekan Mulai Kamera.`, "info");
            }
        });

        btnReset.addEventListener("click", () => {
            repCount = 0;
            pushupStage = "SIAP";
            targetReachedNotified = false;
            elapsedSeconds = 0;
            angleHistory.length = 0;
            depthHistory.length = 0;

            timerDisplayEl.textContent = "00:00";
            updateRepDisplay();
            if (isPaused) {
                updateStageBadge("DIJEDA", "bg-amber-500/20 text-amber-400 border-amber-500/50");
            } else {
                updateStageBadge("SIAP", "bg-slate-800 text-slate-300 border-slate-700");
            }
            showToast("Penghitung dan durasi latihan telah direset.", "info");
        });

        btnSound.addEventListener("click", () => {
            soundEnabled = !soundEnabled;
            document.getElementById("icon-sound-on").classList.toggle("hidden", !soundEnabled);
            document.getElementById("icon-sound-off").classList.toggle("hidden", soundEnabled);
            if (soundEnabled) playTone(660, 0.08);
        });

        // Boot up MediaPipe Pose Landmarker on page load
        initializePoseLandmarker();
    </script>
</body>
</html>
